chroma_db
.cache

# Python / tooling noise
**/__pycache__
**/*.pyc
**/*.egg-info
.pytest_cache
.venv
venv

# Not needed inside the image
Dockerfile
docker-compose.yml
.dockerignore

# OS / editor
.DS_Store
.idea
.vscode
