# Powers the grading role (routing, relevance/hallucination/answer grading,
# query rewriting) - default provider is Groq.
GROQ_API_KEY=your_groq_api_key_here

# Powers the generation role (the final, user-facing answer) - default
# provider is Google Gemini. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Required only for the web_search fallback node. Free tier available.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional - leave this commented out unless you have a real token. It
# authenticates local HuggingFace embedding downloads: not needed for the
# default public model, but avoids anonymous rate limits and is required for
# gated models. (A placeholder or invalid value can make downloads fail
# with a 401, so don't leave a fake one in.) Get one at
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (defaults are in src/config.py) ---
# GRADING_LLM_PROVIDER=groq
# GRADING_LLM_MODEL=llama-3.3-70b-versatile
# GENERATION_LLM_PROVIDER=google
# GENERATION_LLM_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# RERANKER_CACHE_DIR=./.cache/flashrank
# CHROMA_DIR=./chroma_db
# DATA_DIR=./data/sample_docs
